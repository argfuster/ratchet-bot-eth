# Copiar este archivo a .env y completar con tus valores reales.
# NUNCA subir el .env con las claves reales a git ni compartirlo.

# --- Credenciales Binance (API key con permisos de Futures habilitados) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Modo de operación ---
BINANCE_TESTNET=false
DRY_RUN=true

# --- Estrategia ---
SYMBOL=ETHUSDT
LEVERAGE=3
POSITION_PCT_CAPITAL=0.95
EMA_SPAN=50
SL_FRACTION=0.5
POLL_SECONDS=30

# --- Notificaciones (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Archivos de estado/log ---
STATE_FILE=ratchet_bot_state.json
LOG_FILE=ratchet_bot.log
